# ── Backend ComunApp · variables de entorno ─────────────────────
# En Railway NO editas un .env: defines estas variables en
# Service → Variables. Railway inyecta DATABASE_URL y PORT solas.

# Railway la genera al conectar el servicio PostgreSQL (usa la variable interna):
#   DATABASE_URL = {{ Postgres.DATABASE_URL }}
# En local puedes dejarla en blanco para usar SQLite:
DATABASE_URL=postgresql://usuario:clave@host:5432/railway

# Clave para firmar los JWT. GENERA UNA LARGA Y ÚNICA en producción.
SECRET_KEY=pon_aqui_una_clave_larga_y_aleatoria

# CORS: dominios aceptados, separados por coma. Se define como variable de
# entorno / secreto (Railway: Service → Variables). Ejemplo en producción:
#   CORS_ORIGINS=https://comunapp-comunap.up.railway.app,https://admin.ejemplo.cl
# Vacío (recomendado) = modo restringido por defecto: cualquier *.up.railway.app
#   + http://localhost:puerto (cubre Railway y desarrollo sin configurar nada).
# "*" = permite CUALQUIER origen (permisivo). NO usar en producción; solo local.
CORS_ORIGINS=

# URL pública de esta API (Mercado Pago la usará para el webhook de pagos):
# Producción ComunApp: https://backend-comunapp.up.railway.app
BASE_URL=https://tu-api.up.railway.app

# URL pública del frontend (botones de vuelta del Checkout Pro):
# Producción ComunApp: https://comunapp-comunap.up.railway.app
FRONTEND_URL=https://tu-frontend.up.railway.app

# (Opcional) Token de Mercado Pago de la PLATAFORMA (fallback del webhook):
MP_ACCESS_TOKEN=
