# ── Frontend ComunApp · variables de entorno ────────────────────
# IMPORTANTE: Vite inyecta las variables VITE_* en el MOMENTO DEL BUILD.
# En Railway defínela en Service → Variables ANTES de desplegar y luego
# fuerza un Redeploy para que quede "horneada" en el bundle.

# URL pública de tu API (el servicio backend en Railway). Ej:
VITE_API_URL=https://comunapp-api.up.railway.app

# Si la dejas vacía, la app opera con datos locales en el navegador
# (útil para diseño y pruebas sin backend). Con un valor definido, la app
# habla con la API real y los datos viven en PostgreSQL.
