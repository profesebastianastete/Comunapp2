dist/
build/
*.js.map
*.tsbuildinfo

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage
coverage/
.nyc_output/
istanbul/
*.lcov

# Temporary files
*.tmp
.DS_Store
Thumbs.db

# Package manager
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
.next/
.nuxt/
```